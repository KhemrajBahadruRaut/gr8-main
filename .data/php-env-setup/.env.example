# Demo settings for the PHP backend. Replace SMTP placeholders before sending email.
# This file belongs at C:/xampp/htdocs/gr8/.env, not in the Next.js frontend.

PROJECT_EMAIL_PROVIDER=smtp
PROJECT_VERIFICATION_FROM_EMAIL=projects@example.com
PROJECT_VERIFICATION_FROM_NAME="GR8 Nepal"

# SMTP email provider settings. Use your provider's real host and credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD="your-smtp-password"
SMTP_ENCRYPTION=tls

# For Resend instead, set PROJECT_EMAIL_PROVIDER=resend and fill this key.
RESEND_API_KEY=

# Comma-separated frontend URLs allowed to call the PHP endpoints.
PROJECT_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,https://gr8.com.np,https://www.gr8.com.np"

# Keep false for local HTTP; set true when deploying behind HTTPS.
PROJECT_COOKIE_SECURE=false
